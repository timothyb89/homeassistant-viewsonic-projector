    "step": {
      "user": {
        "title": "Connect a ViewSonic projector",
        "description": "Connect the projector's RS-232 port to a serial port Home Assistant can reach, for example a USB serial adapter or an ESPHome serial proxy such as the Home Assistant Connect AUX-2.",
        "data": {
          "device": "Serial port",
          "baud_rate": "Baud rate",
          "model": "Model"
        },
        "data_description": {
          "device": "The serial port the projector is connected to.",
          "baud_rate": "Must match the projector's RS-232 baud rate setting. Most ViewSonic projectors default to 115200.",
          "model": "Pick your model, or type it in if it is not listed. Known models get a user interface tailored to their inputs and settings."
        }
      },
      "troubleshoot": {
        "title": "No response from the projector",
        "description": "The serial port opened, but the projector did not answer a power status query.\n\nCheck that:\n- The projector is plugged in. Some models only answer over RS-232 while switched on, so try again with the projector on.\n- The baud rate matches the projector's setting (115200 by default).\n- The cable is wired correctly. Only RX, TX and ground are used; depending on the adapter you may need a null-modem (crossover) cable or adapter.\n- The correct serial port was selected.\n\nSelect **Submit** to go back and try again."
      },
      "reconfigure": {
        "title": "Reconfigure the projector connection",
        "data": {
          "device": "Serial port",
          "baud_rate": "Baud rate",
          "model": "Model"
        },
